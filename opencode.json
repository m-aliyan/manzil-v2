{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/DESIGN.md",
    ".opencode/skills/design-system/SKILL.md",
    ".opencode/skills/frontend-design-direction/SKILL.md",
    ".opencode/skills/verification-loop/SKILL.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "npm run check": "allow",
      "npm run lint": "allow",
      "npm run typecheck": "allow",
      "npm run build": "allow",
      "npm run dev": "allow",
      "npm run start": "allow",
      "npm run format": "allow",
      "npm install": "ask",
      "npm install *": "ask",
      "npm uninstall *": "ask",
      "npm update*": "deny",
      "git *": "deny",
      "vercel *": "deny",
      "rm *": "ask",
      "del *": "ask",
      "Remove-Item*": "ask"
    },
    "webfetch": "ask",
    "skill": "allow"
  }
}
